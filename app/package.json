{
  "name": "tamil-stoic-app-react",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Tamil Stoic — Thirukkural reader PWA. React 18 + TypeScript rewrite.",
  "scripts": {
    "sync": "node scripts/sync-assets.mjs && node scripts/sync-kurals.mjs",
    "sync-assets": "node scripts/sync-assets.mjs",
    "sync-data": "node scripts/sync-kurals.mjs",
    "check-assets": "node scripts/sync-assets.mjs --check",
    "check-data": "node scripts/sync-kurals.mjs --check",
    "dev": "npm run sync && vite",
    "build": "npm run sync && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:tokens": "node scripts/test-tokens.mjs",
    "test": "npm run check-assets && npm run check-data && npm run test:tokens && npm run test:reader && npm run typecheck",
    "test:reader": "node --experimental-strip-types scripts/test-reader.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "three": "^0.165.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.165.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0"
  }
}
